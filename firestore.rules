rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Each user owns everything under users/{uid}: profile, challenges, pieces, friends.
    match /users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Shared challenges: members read/write; anyone signed in may add only themselves.
    match /sharedChallenges/{id} {
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
                    && request.resource.data.members == [request.auth.uid];
      allow read: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
         && request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [request.auth.uid].toSet()));
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
    }
  }
}
